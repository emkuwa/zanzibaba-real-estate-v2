# SMTP for inquiry emails (optional but recommended)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Zanzibaba Real Estate" <noreply@zanzibaba.com>
# Recipient for lead notifications. Falls back to SITE.email (info@zanzibaba.com) if unset.
LEAD_EMAIL_TO=info@zanzibaba.com

# Google Sheets storage (production). Create a service account in Google Cloud,
# share the target spreadsheet with the service account email as Editor.
# GOOGLE_SHEETS_ID=1AbCdEf... (the long ID in the sheet URL)
# GOOGLE_SHEETS_CREDENTIALS={"type":"service_account","project_id":"...","private_key":"-----BEGIN ...","client_email":"..."}
# GOOGLE_SHEETS_RANGE=Leads!A:O

# Google Places API (optional, enables live hotel discovery). Without it,
# /admin/discovery falls back to a small sample catalog for UI testing.
# GOOGLE_PLACES_API_KEY=AIza...

# Admin CRM dashboard API key
ADMIN_API_KEY=your-secure-admin-key-here

# Public site URL
NEXT_PUBLIC_SITE_URL=https://realestate.zanzibaba.com

# Cal.com / scheduling URL for "Book a Call" CTA
NEXT_PUBLIC_BOOK_CALL_URL=https://cal.com/zanzibaba/investor-call

# Meta Pixel ID (Facebook / Instagram ads)
NEXT_PUBLIC_META_PIXEL_ID=

# LinkedIn Insight Tag partner ID
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=
